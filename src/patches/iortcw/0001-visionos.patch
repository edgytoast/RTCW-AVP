 	float	xmin, xmax, ymin, ymax;
 	float	width, height, stereoSep = r_stereoSeparation->value;
 
+#ifdef VISIONOS
+	// Immersive: per-eye asymmetric frustum from the compositor's view tangents,
+	// parallel eye axes offset by the eye's position (RTCWQuest tr_main.c/tr_scene.c idea).
+	float tan4[4], eyeX, sep;
+	if ( VOS_XR_Active() && VOS_XR_GetEye( dest->stereoFrame == STEREO_RIGHT ? 1 : 0, tan4, &eyeX ) ) {
+		xmin = -tan4[0] * zProj;
+		xmax =  tan4[1] * zProj;
+		ymax =  tan4[2] * zProj;
+		ymin = -tan4[3] * zProj;
+		width = xmax - xmin;
+		height = ymax - ymin;
+		sep = -eyeX * VOS_WORLDSCALE;   // + = eye to the left (axis[1])
+
+		Com_Memset( dest->projectionMatrix, 0, sizeof( dest->projectionMatrix ) );
+		dest->projectionMatrix[0] = 2 * zProj / width;
+		dest->projectionMatrix[8] = ( xmax + xmin ) / width;
+		dest->projectionMatrix[12] = 2 * zProj * sep / width;
+		dest->projectionMatrix[5] = 2 * zProj / height;
+		dest->projectionMatrix[9] = ( ymax + ymin ) / height;
+		dest->projectionMatrix[11] = -1;
+
+		if ( computeFrustum )
+			R_SetupFrustum( dest, xmin - sep, xmax - sep, MAX( ymax, -ymin ), zProj, sep );
+		return;
+	}
+#endif
