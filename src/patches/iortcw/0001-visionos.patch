+			RotatePointAroundVector( u, parms.or.axis[0], parms.or.axis[2], roll );
+			VectorCopy( l, parms.or.axis[1] );
+			VectorCopy( u, parms.or.axis[2] );
+			VectorCopy( l, tr.refdef.viewaxis[1] );
+			VectorCopy( u, tr.refdef.viewaxis[2] );
